# ---------- Data ----------
# Raw data: keep folder structure and READMEs; ignore large or licence-restricted files.
data/raw/sec_edgar/**
!data/raw/sec_edgar/**/
!data/raw/sec_edgar/**/.gitkeep
data/raw/fannie_mae_mflpd/**
!data/raw/fannie_mae_mflpd/.gitkeep
# Market prices (Yahoo Finance terms): kept local, not redistributed
data/raw/market/**
!data/raw/market/.gitkeep
data/raw/rating_agency/**/*.pdf
data/raw/rating_agency/**/*.xlsx
data/raw/naic/**/*.pdf

# S&P tables entered by hand: kept local by default because S&P's terms restrict redistribution.
# The engine and tests run without them (tests skip; see data/external/README.md).
data/external/transition_matrix_1y.csv
data/external/cumulative_default_rates.csv
data/external/default_rates_annual.csv

# ICE BofA spread series (FRED BAML*): ICE's terms restrict redistribution; download locally
data/raw/fred/spreads/BAML*.csv

# Derived data is reproducible from raw data and code
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Large artefacts
*.parquet
*.duckdb
*.duckdb.wal
*.h5
*.pkl

# ---------- Reports ----------
# Figures are committed (they illustrate README results); tables are regenerated by scripts/.
reports/tables/*
!reports/tables/.gitkeep
